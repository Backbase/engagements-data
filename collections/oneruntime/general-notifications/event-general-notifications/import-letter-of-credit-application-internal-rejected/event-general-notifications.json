{
  "eventClassName": "com.backbase.lending.tradefinance.letterofcredit.event.spec.v1.ImportLetterOfCreditApplicationInternalRejectedEvent",
  "id": "import-letter-of-credit-application-internal-rejected",
  "eventBusinessName": "Import Letter of Credit Application Internal Rejected",
  "recipientType": "internal",
  "extractor": "#this['contributorsIds']",
  "serviceAgreementExtractor": "#this['serviceAgreementId']",
  "generalNotifications": [
    {
      "id": "import-letter-of-credit-application-internal-rejected",
      "name": "Import Letter of Credit Application Internal Rejected",
      "userPreferenceEnabled": false,
      "manageable": false,
      "deliveryOptions": [
        {
          "channel": "in-app-notification",
          "channelSettings": "/import-letter-of-credit-application-internal-rejected/in-app-notification/in-app_channel-settings.json",
          "isEnabledByDefault": true,
          "isManageableByUser": false,
          "routeInfo": {
            "whereTo": "import-lc-view",
            "data": "{\"serviceAgreementId\":\"{{serviceAgreementId}}\",\"id\":\"{{event.applicationId}}\"}"
          },
          "engagementTemplates": [
            {
              "path": "/import-letter-of-credit-application-internal-rejected/in-app-notification/en_US/engagement-template.json",
              "locale": "en_US"
            }
          ]
        }
      ]
    }
  ]
}
